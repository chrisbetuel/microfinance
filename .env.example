# Frontend dev config. Copy to .env for local overrides.
#
# Dev server port (default 5173):
# FRONTEND_PORT=5175
#
# The app calls /api/* and Vite proxies it to the backend (default :8000).
# Point the proxy elsewhere if the backend runs on another port:
# VITE_API_PROXY=http://localhost:8001
#
# For non-dev builds where there is no proxy, make the app call the API directly
# (the backend's CORS_ORIGINS must then include the site origin):
# VITE_API_BASE_URL=https://api.example.com
