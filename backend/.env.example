# Postgres for local dev; leave unset to use a local SQLite file.
DATABASE_URL=postgres://lms:lms_dev_password@localhost:5432/lms
JWT_SECRET_KEY=dev-insecure-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
DEBUG=1

# SMS gateway — Haflaway / SMTZ (https://messaging.haflaway.com → Developers → API keys)
# LMS_SMS_PROVIDER=haflaway
# LMS_SMS_API_KEY=smtz_your_api_key
# LMS_SMS_SENDER_ID=YOURNAME        # must be approved in the Haflaway dashboard (max 11 chars)
# LMS_SMS_ALLOWED_NUMBERS=0618750312   # test mode: only these numbers are texted (remove to go fully live)
# LMS_SMS_WEBHOOK_SECRET=whsec_...  # shown once when you register https://<your-api>/sms/haflaway/webhook
